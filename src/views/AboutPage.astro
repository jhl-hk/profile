---
import { Image } from 'astro:assets';
import portrait from '../assets/profile/portrait.jpg';
import PageIntro from '../components/PageIntro.astro';
import ProfileTimeline from '../components/ProfileTimeline.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data/profile';
import { getUiCopy } from '../i18n/ui';
import SiteLayout from '../layouts/SiteLayout.astro';
import { localizedPath, type Locale } from '../lib/i18n';
import { staticLanguageTargets } from '../lib/seo';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const businessSkills = profile.skills.filter((skill) => skill.category === 'business');
const technicalGroups = (['programming', 'web', 'infrastructure'] as const).map((group) => ({
	group,
	skills: profile.skills.filter((skill) => skill.category === 'technical' && 'group' in skill && skill.group === group),
}));
const levelSteps = [1, 2, 3, 4, 5] as const;
const languages = profile.skills.filter((skill) => skill.category === 'language');
const interests = profile.interests;
const pathname = localizedPath(locale, '/about/');
---

<SiteLayout
	locale={locale}
	title={copy.about.title}
	description={profile.copy[locale].bio}
	pathname={pathname}
	languageTargets={staticLanguageTargets('/about/')}
>
	<div class="page-shell">
		<PageIntro locale={locale} hop="about" eyebrow={copy.nav.about} title={copy.about.title} />

		<section class="profile-overview" aria-labelledby="profile-name">
			<Image class="portrait surface" src={portrait} width={480} height={480} alt={profile.name} loading="eager" data-reveal />
			<div data-reveal>
				<p class="eyebrow">{copy.about.biography}</p>
				<h2 id="profile-name">{profile.legalName}</h2>
				<p class="profile-role">{profile.copy[locale].role} · {profile.copy[locale].location}</p>
				<ul class="profile-points">
					{profile.copy[locale].highlights.map((point) => <li>{point}</li>)}
				</ul>
				<SocialLinks locale={locale} />
			</div>
		</section>

		<ProfileTimeline locale={locale} title={copy.about.work} records={profile.work} />
		<ProfileTimeline locale={locale} title={copy.about.projects} records={profile.projects} />
		<ProfileTimeline locale={locale} title={copy.about.education} records={profile.education} />

		<section class="profile-details" aria-labelledby="interests-title" data-reveal>
			<h2 id="interests-title" data-scroll-heading>{copy.about.interests}</h2>
			<ul class="interests">
				{interests.map((interest) => <li>{interest.copy[locale].label}</li>)}
			</ul>
		</section>

		<section class="profile-details" aria-labelledby="skills-title" data-reveal>
			<h2 id="skills-title" data-scroll-heading>{copy.about.skills}</h2>
			<div class="skill-grid">
				<div class="skill-technical">
					<h3>{copy.about.technical}</h3>
					<dl class="skill-groups">
						{technicalGroups.map(({ group, skills }) => (
							<div>
								<dt>{copy.about.skillGroups[group]}</dt>
								<dd>
									<ul class="skill-chips">
										{skills.map((skill) => <li>{skill.copy[locale].label}</li>)}
									</ul>
								</dd>
							</div>
						))}
					</dl>
				</div>
				<div>
					<h3>{copy.about.business}</h3>
					<ul class="skill-list">{businessSkills.map((skill) => <li>{skill.copy[locale].label}</li>)}</ul>
				</div>
				<div>
					<h3>{copy.about.languages}</h3>
					<ul class="skill-list">
						{languages.map((skill) => {
							const level = 'level' in skill ? skill.level : 0;
							return (
								<li class="language">
									<span class="language-name">{skill.copy[locale].label}</span>
									<span class="language-meter" aria-hidden="true">
										{levelSteps.map((step) => <i class:list={{ filled: step <= level }} />)}
									</span>
									<span class="language-proficiency">{skill.copy[locale].proficiency}</span>
								</li>
							);
						})}
					</ul>
				</div>
			</div>
		</section>

		<section class="profile-details" aria-labelledby="certifications-title" data-reveal>
			<h2 id="certifications-title" data-scroll-heading>{copy.about.certifications}</h2>
			<ul class="certifications">
				{profile.certifications.map((certification) => (
					<li><strong>{certification.copy[locale].name}</strong><span>{certification.issuer}</span></li>
				))}
			</ul>
		</section>
	</div>
</SiteLayout>

<style>
	.profile-overview {
		display: grid;
		grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1.55fr);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: start;
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}

	.portrait {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.profile-overview h2 {
		margin-bottom: 0.25rem;
		font-size: clamp(1.8rem, 4vw, 3.1rem);
	}

	.profile-role {
		margin-bottom: 1.5rem;
		color: var(--text-muted);
	}

	.profile-points {
		display: grid;
		gap: 0.5rem;
		margin: 0 0 1.75rem;
		padding: 0;
		list-style: none;
	}

	.profile-points li {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.profile-points li::before {
		content: '▸';
		content: '▸' / '';
		color: var(--accent);
		font-family: var(--font-mono);
	}

	.profile-details {
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-top: 1px solid var(--border);
	}

	.profile-details > h2 {
		margin-bottom: 1.5rem;
		font-size: clamp(1.6rem, 3vw, 2.4rem);
	}

	.skill-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 5vw, 4rem);
	}

	.skill-grid h3 {
		font-size: 1rem;
	}

	.skill-technical {
		grid-column: 1 / -1;
	}

	.skill-groups {
		display: grid;
		margin: 0;
	}

	.skill-groups > div {
		display: grid;
		grid-template-columns: minmax(7rem, 0.22fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding-block: 0.85rem;
		border-top: 1px solid var(--border);
	}

	.skill-groups dt {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.skill-groups dt::before {
		content: '// ';
		content: '// ' / '';
		color: var(--accent);
	}

	.skill-groups dd {
		margin: 0;
	}

	.skill-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-chips li {
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface-raised);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out);
	}

	@media (hover: hover) {
		.skill-chips li:hover {
			border-color: var(--accent);
			color: var(--accent-strong);
		}
	}

	.skill-list,
	.interests,
	.certifications {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-list li,
	.interests li,
	.certifications li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.65rem;
		border-top: 1px solid var(--border);
	}

	.certifications li span {
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.skill-list .language {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.15rem 1rem;
	}

	.language-meter {
		display: inline-flex;
		gap: 3px;
	}

	.language-meter i {
		width: 1.1rem;
		height: 0.35rem;
		border-radius: 1px;
		background: var(--border);
	}

	.language-meter i.filled {
		background: var(--accent);
	}

	.language-proficiency {
		grid-column: 1 / -1;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.certifications {
		max-width: 44rem;
	}

	.interests {
		max-width: 44rem;
	}

	@media (max-width: 720px) {
		.profile-overview,
		.skill-grid,
		.skill-groups > div {
			grid-template-columns: 1fr;
		}

		.skill-groups > div {
			gap: 0.5rem;
		}

		.portrait {
			max-width: 8rem;
		}
	}
</style>
