---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { adjacentPosts, estimateReadingMinutes, translationTargets } from '../lib/content';
import { locales } from '../lib/i18n';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const posts = await getCollection('blog', ({ data }) => locales.includes(data.lang));
const { Content, headings } = await render(post);
const { previous, next } = adjacentPosts(posts, post, post.data.lang);
---

<BlogPost
	post={post}
	locale={post.data.lang}
	headings={headings}
	readingMinutes={estimateReadingMinutes(post.body)}
	languageTargets={translationTargets(posts, post)}
	previous={previous}
	next={next}
>
	<Content />
</BlogPost>
