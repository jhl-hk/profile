---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_ORIGIN, SITE_TITLE } from '../consts';
import { defaultLocale, type Locale } from '../lib/i18n';
import { buildSeoLinks, type LanguageTargets } from '../lib/seo';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	locale?: Locale;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	languageTargets?: LanguageTargets;
}

const {
	title,
	description,
	locale = defaultLocale,
	image = FallbackImage,
	type = 'website',
	languageTargets = { [defaultLocale]: Astro.url.pathname },
} = Astro.props;
const origin = SITE_ORIGIN;
const { canonical, alternates } = buildSeoLinks(origin.toString(), locale, languageTargets);
const imagePath = typeof image === 'string' ? image : image.src;
const imageUrl = new URL(imagePath, origin).href;
const openGraphLocales: Record<Locale, string> = {
	en: 'en_US',
	ja: 'ja_JP',
	zh: 'zh_CN',
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} — ${locale.toUpperCase()}`}
	href={new URL(`/${locale}/rss.xml`, origin)}
/>
<Font cssVariable="--font-atkinson" preload />

<script is:inline>
	(() => {
		let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		try {
			const saved = localStorage.getItem('theme');
			if (saved === 'light' || saved === 'dark') theme = saved;
		} catch {}
		document.documentElement.dataset.theme = theme;
	})();
</script>

<link rel="canonical" href={canonical} />
{
	alternates.map(({ lang, href }) => (
		<link rel="alternate" hreflang={lang} href={href} />
	))
}

<title>{title}</title>

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={openGraphLocales[locale]} />
{
	alternates
		.filter(({ lang }) => lang !== locale && lang !== 'x-default')
		.map(({ lang }) => (
			<meta property="og:locale:alternate" content={openGraphLocales[lang as Locale]} />
		))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
