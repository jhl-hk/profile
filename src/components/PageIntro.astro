---
import type { Locale } from '../lib/i18n';
import TraceBreadcrumb from './TraceBreadcrumb.astro';

interface Props {
	locale: Locale;
	/** Last breadcrumb hop: the page's path segment, e.g. `projects`. */
	hop: string;
	eyebrow: string;
	title: string;
	description?: string;
}

const { locale, hop, eyebrow, title, description } = Astro.props;
---

<header class="page-intro">
	<TraceBreadcrumb locale={locale} hops={[{ label: hop }]} />
	<p class="eyebrow" data-reveal>{eyebrow}</p>
	<h1 data-reveal>{title}</h1>
	{description && <p class="description" data-reveal>{description}</p>}
</header>

<style>
	.page-intro {
		max-width: 52rem;
		margin-bottom: clamp(3rem, 8vw, 6rem);
	}

	h1 {
		margin-bottom: 0.35em;
	}

	.description {
		max-width: 42rem;
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-reading);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
	}
</style>
