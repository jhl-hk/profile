---
import type { HTMLAttributes } from 'astro/types';
import { isNavigationPathActive } from '../lib/navigation';

type Props = HTMLAttributes<'a'> & { exact?: boolean };

const { href = '/', class: className, exact = false, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const isActive = isNavigationPathActive(pathname, href, exact);
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	a {
		display: inline-flex;
		min-width: 2.75rem;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		padding: 0.45rem 0.85rem;
		border-radius: var(--radius-pill);
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	a:hover {
		color: var(--text);
	}

	a.active {
		background: var(--surface-muted);
		color: var(--text);
	}
</style>
