---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatReadingTime, type Locale } from '../lib/i18n';
import { postSlug } from '../lib/content';

interface Props {
	post: CollectionEntry<'blog'>;
	locale: Locale;
	readingMinutes: number;
}

const { post, locale, readingMinutes } = Astro.props;
const sampleLabel = { en: 'Sample', ja: 'サンプル', zh: '示例' } as const;
const href = `/${locale}/blog/${postSlug(post)}/`;
---

<article class="post-row">
	<div class="post-meta meta">
		<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
		<span aria-hidden="true">·</span>
		<span>{formatReadingTime(readingMinutes, locale)}</span>
		{post.data.sample && <span class="sample-badge">{sampleLabel[locale]}</span>}
	</div>
	<h3><a href={href}>{post.data.title}</a></h3>
	<p>{post.data.description}</p>
	{
		post.data.topics.length > 0 && (
			<ul class="post-topics" aria-label="Topics">
				{post.data.topics.map((topic) => <li>{topic}</li>)}
			</ul>
		)
	}
</article>

<style>
	.post-row {
		padding-block: 1.65rem;
		border-top: 1px solid var(--border);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.65rem;
	}

	.sample-badge {
		padding: 0.08rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border));
		border-radius: var(--radius-pill);
		color: var(--accent-strong);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.35rem, 3vw, 2rem);
	}

	h3 a {
		color: var(--text);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent-strong);
	}

	p {
		max-width: 44rem;
		margin: 0 0 0.85rem;
		color: var(--text-muted);
		font-family: var(--font-reading);
	}

	.post-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-topics li {
		color: var(--text-faint);
		font-size: 0.78rem;
	}

	.post-topics li::before {
		content: '#';
	}
</style>
