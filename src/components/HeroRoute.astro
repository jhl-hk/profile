---
import {
	heroMapAirports,
	heroMapLand,
	heroMapLegs,
	heroMapMeridians,
	heroMapParallels,
	heroMapRoute,
	heroMapViewBox,
} from '../data/hero-map';

// Label offsets keep the codes clear of the route and of each other.
const labelOffsets: Record<string, { x: number; y: number; anchor: 'start' | 'end' }> = {
	ZSHC: { x: -10, y: 16, anchor: 'end' },
	ZSPD: { x: 10, y: 18, anchor: 'start' },
	RJTT: { x: 10, y: -10, anchor: 'start' },
};
// Each great-circle leg, listed in the map's top-right corner.
const legSummaries = heroMapLegs.map((leg) => `${leg.from}–${leg.to} ${leg.nm} NM`);
const [, origin] = heroMapAirports;
---

<div class="hero-route" aria-hidden="true" data-hero-route>
	<svg viewBox={heroMapViewBox}>
		<g class="graticule">
			{heroMapMeridians.map(({ label, x }) => (
				<>
					<line x1={x} y1="0" x2={x} y2="100%" />
					<text x={x + 4} y="98%">{label}</text>
				</>
			))}
			{heroMapParallels.map(({ label, y }) => (
				<>
					<line x1="0" y1={y} x2="100%" y2={y} />
					<text x="4" y={y - 4}>{label}</text>
				</>
			))}
		</g>
		<path class="land" d={heroMapLand} />
		<path class="route-plan" d={heroMapRoute} />
		<path class="route" d={heroMapRoute} data-hero-path />
		<g class="legs">
			{legSummaries.map((summary, index) => (
				<text x="500" y={268 + index * 13}>{summary}</text>
			))}
		</g>
		{heroMapAirports.map(({ id, city, x, y }) => {
			const offset = labelOffsets[id];
			return (
				<g class="waypoint" transform={`translate(${x} ${y})`}>
					<g data-hero-waypoint>
						<circle r="4.5" />
						<text x={offset.x} y={offset.y} text-anchor={offset.anchor}>
							<tspan class="code">{id}</tspan>
							<tspan class="city" x={offset.x} dy="11">{city}</tspan>
						</text>
					</g>
				</g>
			);
		})}
		<g class="plane" transform={`translate(${origin.x} ${origin.y}) rotate(-22)`} data-hero-plane>
			<path d="M11 0 L5 -1.3 L-1 -9 L-3.6 -9 L0 -1.3 L-6 -1.3 L-8.5 -4 L-10 -4 L-8.5 0 L-10 4 L-8.5 4 L-6 1.3 L0 1.3 L-3.6 9 L-1 9 L5 1.3 Z" />
		</g>
	</svg>
</div>

<script>
	import { initHeroRoute } from '../lib/live-motion';

	const hero = document.querySelector<HTMLElement>('[data-hero-route]')?.parentElement;
	if (hero) initHeroRoute(hero);
</script>

<style>
	/* Faded edges hide where the land is cut at the map frame. */
	.hero-route {
		position: absolute;
		z-index: -1;
		top: -1rem;
		right: -3rem;
		width: min(38rem, 54vw);
		pointer-events: none;
		mask-image:
			linear-gradient(to right, transparent, #000 14%, #000 90%, transparent),
			linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
		mask-composite: intersect;
	}

	svg {
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.graticule line {
		stroke: var(--border);
		stroke-dasharray: 2 6;
	}

	.graticule text,
	.legs text {
		fill: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
	}

	.legs text {
		font-weight: 700;
		text-anchor: end;
	}

	/* Fill only: a stroke would also outline where land is cut at the map frame. */
	.land {
		fill: color-mix(in srgb, var(--text-faint) 14%, transparent);
	}

	/* The planned track stays dashed; the flown track draws over it. */
	.route-plan,
	.route {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.route-plan {
		stroke: var(--accent);
		stroke-dasharray: 3 5;
		stroke-opacity: 0.45;
		stroke-width: 1;
	}

	.route {
		stroke: var(--accent);
		stroke-width: 1.75;
	}

	.waypoint circle {
		fill: var(--surface);
		stroke: var(--accent);
		stroke-width: 1.5;
	}

	[data-hero-waypoint] {
		transform-box: fill-box;
		transform-origin: center;
	}

	.waypoint text {
		fill: var(--text-faint);
		font-family: var(--font-mono);
		letter-spacing: 0.08em;
	}

	.waypoint .code {
		fill: var(--text-muted);
		font-size: 11px;
		font-weight: 700;
	}

	.waypoint .city {
		font-size: 9px;
	}

	.plane path {
		fill: var(--text);
		stroke: var(--surface);
		stroke-width: 1;
	}

	@media (max-width: 720px) {
		.hero-route {
			top: auto;
			right: -1rem;
			bottom: 8rem;
			width: 92vw;
			opacity: 0.35;
		}
	}
</style>
