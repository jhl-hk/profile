---
import { SITE_NAME } from "../consts";
import { getUiCopy } from "../i18n/ui";
import { defaultLocale, type Locale } from "../lib/i18n";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getUiCopy(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner page-shell">
    <div>
      <p class="footer-name">{SITE_NAME}</p>
      <p class="footer-meta meta">
        &copy; {year} {copy.footer.copyright}
      </p>
      <p class="powered-by meta">
        {copy.footer.poweredBy.before && <span>{copy.footer.poweredBy.before}</span>}
        <a href="https://yunzheng.space/orbit" target="_blank" rel="noopener">
          <img src="https://yunzheng.space/assets/logo-sm.webp" alt="" width="45" height="20" loading="lazy" decoding="async" />
          Orbit (YunzhengLab)
        </a>
        {copy.footer.poweredBy.after && <span>{copy.footer.poweredBy.after}</span>}
      </p>
    </div>
    <SocialLinks locale={locale} />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 2.5rem 3.5rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1.5rem 2rem;
  }

  .footer-name,
  .footer-meta,
  .powered-by,
  .filing {
    margin: 0;
  }

  .footer-name {
    font-weight: 700;
  }

  .filing {
    grid-column: 1 / -1;
  }

  .powered-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .powered-by a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
  }

  .powered-by a:hover {
    color: var(--accent-strong);
  }

  .powered-by img {
    width: auto;
    height: 1.1rem;
  }

  @media (max-width: 620px) {
    .footer-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .filing {
      grid-column: auto;
    }
  }
</style>
