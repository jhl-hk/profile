---
import PageIntro from '../../../components/PageIntro.astro';
import ProfileTimeline from '../../../components/ProfileTimeline.astro';
import SocialLinks from '../../../components/SocialLinks.astro';
import { profile } from '../../../data/profile';
import { getUiCopy } from '../../../i18n/ui';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../../lib/i18n';
import { staticLanguageTargets } from '../../../lib/seo';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const businessSkills = profile.skills.filter((skill) => skill.category === 'business');
const technicalSkills = profile.skills.filter((skill) => skill.category === 'technical');
const languages = profile.skills.filter((skill) => skill.category === 'language');
const interests = profile.interests;
const pathname = `/${locale}/about/`;
---

<SiteLayout
	locale={locale}
	title={copy.about.title}
	description={profile.copy[locale].bio}
	pathname={pathname}
	languageTargets={staticLanguageTargets('/about/')}
>
	<div class="page-shell">
		<PageIntro eyebrow={copy.nav.about} title={copy.about.title} description={profile.copy[locale].bio} />

		<section class="profile-overview" aria-labelledby="profile-name">
			<div class="monogram surface" role="img" aria-label={profile.name}>JA</div>
			<div>
				<p class="eyebrow">{copy.about.biography}</p>
				<h2 id="profile-name">{profile.legalName}</h2>
				<p class="profile-role">{profile.copy[locale].role} · {profile.copy[locale].location}</p>
				<p class="profile-bio">{profile.copy[locale].bio}</p>
				<SocialLinks locale={locale} />
			</div>
		</section>

		<ProfileTimeline locale={locale} title={copy.about.experience} records={profile.experience} />
		<ProfileTimeline locale={locale} title={copy.about.education} records={profile.education} />

		<section class="profile-details" aria-labelledby="interests-title">
			<h2 id="interests-title">{copy.about.interests}</h2>
			<ul class="interests">
				{interests.map((interest) => <li>{interest.copy[locale].label}</li>)}
			</ul>
		</section>

		<section class="profile-details" aria-labelledby="skills-title">
			<h2 id="skills-title">{copy.about.skills}</h2>
			<div class="detail-grid">
				<div>
					<h3>{copy.about.business}</h3>
					<ul>{businessSkills.map((skill) => <li>{skill.copy[locale].label}</li>)}</ul>
				</div>
				<div>
					<h3>{copy.about.technical}</h3>
					<ul>{technicalSkills.map((skill) => <li>{skill.copy[locale].label}</li>)}</ul>
				</div>
				<div>
					<h3>{copy.about.languages}</h3>
					<ul>
						{languages.map((skill) => <li>{skill.copy[locale].label}<span>{skill.copy[locale].proficiency}</span></li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class="profile-details" aria-labelledby="certifications-title">
			<h2 id="certifications-title">{copy.about.certifications}</h2>
			<ul class="certifications">
				{profile.certifications.map((certification) => (
					<li><strong>{certification.copy[locale].name}</strong><span>{certification.issuer}</span></li>
				))}
			</ul>
		</section>
	</div>
</SiteLayout>

<style>
	.profile-overview {
		display: grid;
		grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1.55fr);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: start;
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}

	.monogram {
		display: grid;
		aspect-ratio: 4 / 5;
		place-items: center;
		background: linear-gradient(145deg, var(--surface-raised), var(--surface-muted));
		color: var(--accent-strong);
		font-family: var(--font-reading);
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 700;
		letter-spacing: -0.06em;
	}

	.profile-overview h2 {
		margin-bottom: 0.25rem;
		font-size: clamp(1.8rem, 4vw, 3.1rem);
	}

	.profile-role {
		margin-bottom: 1.5rem;
		color: var(--text-muted);
	}

	.profile-bio {
		max-width: 45rem;
		font-family: var(--font-reading);
		font-size: 1.15rem;
	}

	.profile-details {
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-top: 1px solid var(--border);
	}

	.profile-details > h2 {
		margin-bottom: 1.5rem;
		font-size: clamp(1.6rem, 3vw, 2.4rem);
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 5vw, 4rem);
	}

	.detail-grid h3 {
		font-size: 1rem;
	}

	.detail-grid ul,
	.interests,
	.certifications {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.detail-grid li,
	.interests li,
	.certifications li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.65rem;
		border-top: 1px solid var(--border);
	}

	.detail-grid li span,
	.certifications li span {
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.certifications {
		max-width: 44rem;
	}

	.interests {
		max-width: 44rem;
	}

	@media (max-width: 720px) {
		.profile-overview,
		.detail-grid {
			grid-template-columns: 1fr;
		}

		.monogram {
			max-width: 12rem;
		}
	}
</style>
