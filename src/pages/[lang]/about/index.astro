---
import { prefixedLocales, type Locale } from '../../../lib/i18n';
import AboutPage from '../../../views/AboutPage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<AboutPage locale={Astro.props.locale} />
