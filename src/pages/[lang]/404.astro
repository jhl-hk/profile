---
import Flaps from '../../components/Flaps.astro';
import NotFoundTerminal from '../../components/NotFoundTerminal.astro';
import { getUiCopy } from '../../i18n/ui';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../lib/i18n';
import { staticLanguageTargets } from '../../lib/seo';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
---

<SiteLayout
	locale={locale}
	title={copy.notFound.title}
	description={copy.notFound.description}
	pathname={`/${locale}/404/`}
	languageTargets={staticLanguageTargets('/404/')}
>
	<section class="not-found page-shell">
		<p class="error-code" aria-hidden="true" data-reveal="flaps"><span class="error-board board-surface"><Flaps text="404" /></span></p>
		<h1 data-reveal>{copy.notFound.title}</h1>
		<p data-reveal>{copy.notFound.description}</p>
		<NotFoundTerminal locale={locale} />
		<a href={`/${locale}/`} data-reveal>{copy.actions.backHome}</a>
	</section>
</SiteLayout>

<style>
	.not-found {
		padding-block: clamp(3rem, 10vw, 9rem);
		text-align: center;
	}

	.error-code {
		margin: 0 0 0.5rem;
	}

	.error-board {
		display: inline-flex;
		padding: 0.4rem 0.5rem 0.4rem 0.64rem;
		color: var(--board-amber);
		font-size: 1.6rem;
	}

	.not-found h1 {
		margin-block: 0.2em;
	}

	.not-found > p:not(.error-code) {
		color: var(--text-muted);
		font-family: var(--font-reading);
		font-size: 1.2rem;
	}

	.not-found a {
		display: inline-flex;
		margin-top: 1.5rem;
		min-height: 2.75rem;
		align-items: center;
		font-weight: 700;
	}
</style>
