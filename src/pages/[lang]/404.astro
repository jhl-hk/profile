---
import { prefixedLocales, type Locale } from '../../lib/i18n';
import NotFoundPage from '../../views/NotFoundPage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<NotFoundPage locale={Astro.props.locale} />
