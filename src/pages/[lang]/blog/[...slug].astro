---
import { type CollectionEntry, getCollection } from 'astro:content';
import { articlePaths } from '../../../lib/content';
import { prefixedLocales } from '../../../lib/i18n';
import ArticlePage from '../../../views/ArticlePage.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft && prefixedLocales.includes(data.lang));
	return articlePaths(posts);
}

interface Props {
	post: CollectionEntry<'blog'>;
}
---

<ArticlePage post={Astro.props.post} />
