---
import { prefixedLocales, type Locale } from '../../../lib/i18n';
import BlogIndexPage from '../../../views/BlogIndexPage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<BlogIndexPage locale={Astro.props.locale} />
