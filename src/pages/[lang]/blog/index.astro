---
import { getCollection } from 'astro:content';
import FeaturedPost from '../../../components/FeaturedPost.astro';
import PostRow from '../../../components/PostRow.astro';
import PostSearch from '../../../components/PostSearch.astro';
import TopicList from '../../../components/TopicList.astro';
import { getUiCopy } from '../../../i18n/ui';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { estimateReadingMinutes, publishedPosts } from '../../../lib/content';
import { locales, type Locale } from '../../../lib/i18n';
import { staticLanguageTargets } from '../../../lib/seo';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const posts = publishedPosts(await getCollection('blog'), locale);
const featured = posts.find((post) => post.data.featured);
const remaining = featured ? posts.filter((post) => post.id !== featured.id) : posts;
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].sort((a, b) => a.localeCompare(b, locale));
const pathname = `/${locale}/blog/`;
---

<SiteLayout
	locale={locale}
	title={copy.blog.title}
	description={copy.blog.title}
	pathname={pathname}
	languageTargets={staticLanguageTargets('/blog/')}
>
	<div class="blog-index page-shell" data-blog-index>
		<header class="blog-header">
			<p class="eyebrow">{copy.nav.blog}</p>
			<h1>{copy.blog.title}</h1>
		</header>

		{
			posts.length > 0 ? (
				<>
					{featured && (
						<div class="featured-wrap" data-featured-wrap>
							<FeaturedPost post={featured} locale={locale} readingMinutes={estimateReadingMinutes(featured.body)} />
						</div>
					)}
					<div class="blog-content">
						<aside class="blog-rail" aria-label={copy.blog.filters}>
							<PostSearch locale={locale} count={posts.length} />
							{topics.length > 0 && <TopicList topics={topics} locale={locale} />}
						</aside>
						<section class="post-list" aria-label={copy.nav.blog}>
							{remaining.map((post) => (
								<PostRow post={post} locale={locale} readingMinutes={estimateReadingMinutes(post.body)} />
							))}
						</section>
					</div>
				</>
			) : (
				<p class="empty-state">{copy.blog.empty}</p>
			)
		}
	</div>
</SiteLayout>

<style>
	.blog-header {
		max-width: 54rem;
		margin-bottom: clamp(3rem, 8vw, 6rem);
	}

	.blog-header h1 {
		margin: 0;
	}

	.featured-wrap {
		margin-bottom: clamp(3rem, 8vw, 6rem);
	}

	.blog-content {
		display: grid;
		grid-template-columns: minmax(13rem, 0.32fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 7vw, 6rem);
		align-items: start;
	}

	.blog-rail {
		position: sticky;
		top: 1.5rem;
		display: grid;
		gap: 2rem;
	}

	.post-list :global(.post-row:last-child) {
		border-bottom: 1px solid var(--border);
	}

	.empty-state {
		padding-block: 1.75rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.blog-content {
			grid-template-columns: 1fr;
		}

		.blog-rail {
			position: static;
		}
	}
</style>
