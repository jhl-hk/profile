---
import PageIntro from '../../../components/PageIntro.astro';
import { linkGroups, linkHost, siteLinkCard } from '../../../data/links';
import { profile } from '../../../data/profile';
import { getUiCopy } from '../../../i18n/ui';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../../lib/i18n';
import { staticLanguageTargets } from '../../../lib/seo';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const pathname = `/${locale}/links/`;
const siteDetails = [
	{ label: copy.links.siteName, value: siteLinkCard.name },
	{ label: copy.links.siteUrl, value: siteLinkCard.url },
	{ label: copy.links.avatar, value: siteLinkCard.avatar },
	{ label: copy.links.description, value: profile.copy[locale].bio },
];
const [applyBefore, applyAfter = ''] = copy.links.applyIntroduction.split('{email}');
---

<SiteLayout
	locale={locale}
	title={copy.links.title}
	description={copy.links.introduction}
	pathname={pathname}
	languageTargets={staticLanguageTargets('/links/')}
>
	<div class="page-shell">
		<PageIntro eyebrow={copy.nav.links} title={copy.links.title} description={copy.links.introduction} />

		{
			linkGroups.map((group) => (
				<section class="link-group" aria-labelledby={`links-${group.id}`}>
					<h2 id={`links-${group.id}`}>{copy.links.groups[group.id]}</h2>
					<ul class="link-grid">
						{group.links.map((link) => (
							<li>
								<a
									class="link-card surface"
									href={link.url}
									target="_blank"
									rel="noopener"
								>
									<span class="link-name">
										{link.name}
										<span class="link-arrow" aria-hidden="true">↗</span>
										<span class="sr-only">({copy.links.visit})</span>
									</span>
									{'description' in link && <span class="link-description">{link.description}</span>}
									<span class="link-host meta">{linkHost(link.url)}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<section class="link-group" aria-labelledby="links-this-site">
			<h2 id="links-this-site">{copy.links.thisSite}</h2>
			<div class="site-card surface">
				<img class="site-avatar" src="/apple-touch-icon.png" width="72" height="72" alt="" loading="lazy" />
				<div>
					<p class="site-intro meta">{copy.links.thisSiteIntroduction}</p>
					<dl class="site-details">
						{
							siteDetails.map((detail) => (
								<div>
									<dt>{detail.label}</dt>
									<dd>{detail.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</section>

		<div class="link-notes">
			<section aria-labelledby="links-guidelines">
				<h2 id="links-guidelines">{copy.links.guidelines}</h2>
				<ol>
					{copy.links.guidelineItems.map((item) => <li>{item}</li>)}
				</ol>
			</section>
			<section aria-labelledby="links-apply">
				<h2 id="links-apply">{copy.links.apply}</h2>
				<p>
					{applyBefore}<a href={`mailto:${siteLinkCard.email}`}>{siteLinkCard.email}</a>{applyAfter}
				</p>
				<ol>
					{copy.links.applyItems.map((item) => <li>{item}</li>)}
				</ol>
			</section>
		</div>
	</div>
</SiteLayout>

<style>
	.link-group {
		padding-block: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--border);
	}

	h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.35rem, 2.3vw, 1.85rem);
	}

	.link-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.link-card {
		display: flex;
		height: 100%;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.15rem 1.25rem;
		color: var(--text);
		text-decoration: none;
		transition: border-color 160ms ease-out;
	}

	.link-card:hover {
		border-color: var(--accent);
	}

	.link-name {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.link-arrow {
		color: var(--text-muted);
	}

	.link-card:hover .link-arrow {
		color: var(--accent-strong);
	}

	.link-description {
		color: var(--text-muted);
		font-family: var(--font-reading);
	}

	.link-host {
		margin-top: auto;
		font-size: 0.8rem;
		overflow-wrap: anywhere;
	}

	.site-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.25rem;
		align-items: start;
		padding: 1.25rem;
	}

	.site-avatar {
		border-radius: var(--radius-small);
	}

	.site-intro {
		margin: 0 0 1rem;
	}

	.site-details {
		display: grid;
		gap: 0.65rem;
		margin: 0;
	}

	.site-details div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
	}

	.site-details dt {
		color: var(--text-muted);
		font-size: 0.88rem;
		font-weight: 700;
	}

	.site-details dd {
		margin: 0;
		overflow-wrap: anywhere;
		user-select: all;
	}

	.link-notes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 4rem);
		padding-block: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--border);
	}

	.link-notes p,
	.link-notes ol {
		margin: 0 0 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-reading);
	}

	.link-notes a {
		color: var(--accent-strong);
	}

	@media (max-width: 720px) {
		.link-grid,
		.link-notes {
			grid-template-columns: 1fr;
		}

		.site-card {
			grid-template-columns: 1fr;
		}

		.site-details div {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
