---
import { prefixedLocales, type Locale } from '../../../lib/i18n';
import LinksPage from '../../../views/LinksPage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<LinksPage locale={Astro.props.locale} />
