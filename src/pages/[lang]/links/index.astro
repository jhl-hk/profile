---
import type { ComponentProps } from 'astro/types';
import CodeWindow from '../../../components/CodeWindow.astro';
import PageIntro from '../../../components/PageIntro.astro';
import { linkGroups, linkHost, siteLinkCard } from '../../../data/links';
import { profile } from '../../../data/profile';
import { getUiCopy } from '../../../i18n/ui';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../../lib/i18n';
import { staticLanguageTargets } from '../../../lib/seo';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const pathname = `/${locale}/links/`;
const yamlString = (value: string) => `"${value.replaceAll('\\', '\\\\').replaceAll('"', '\\"')}"`;
const siteFields = [
	{ key: 'name', value: siteLinkCard.name, label: copy.links.siteName },
	{ key: 'url', value: siteLinkCard.url, label: copy.links.siteUrl },
	{ key: 'avatar', value: siteLinkCard.avatar, label: copy.links.avatar },
	{ key: 'description', value: profile.copy[locale].bio, label: copy.links.description },
];
const siteYaml: ComponentProps<typeof CodeWindow>['lines'] = siteFields.map(({ key, value, label }, index) => [
	[null, index === 0 ? '- ' : '  '],
	['keyword', key],
	[null, ': '],
	['string', yamlString(value)],
	['comment', `  # ${label}`],
]);
const [applyBefore, applyAfter = ''] = copy.links.applyIntroduction.split('{email}');
---

<SiteLayout
	locale={locale}
	title={copy.links.title}
	description={copy.links.introduction}
	pathname={pathname}
	languageTargets={staticLanguageTargets('/links/')}
>
	<div class="page-shell">
		<PageIntro locale={locale} hop="links" eyebrow={copy.nav.links} title={copy.links.title} description={copy.links.introduction} />

		{
			linkGroups.map((group) => (
				<section class="link-group" aria-labelledby={`links-${group.id}`}>
					<h2 id={`links-${group.id}`} data-reveal>{copy.links.groups[group.id]}</h2>
					<ul class="link-grid">
						{group.links.map((link) => (
							<li data-reveal>
								<a
									class="link-card surface"
									href={link.url}
									target="_blank"
									rel="noopener"
								>
									<span class="link-name">
										{link.name}
										<span class="link-arrow" aria-hidden="true">↗</span>
										<span class="sr-only">({copy.links.visit})</span>
									</span>
									{'description' in link && <span class="link-description">{link.description}</span>}
									<span class="link-host meta"><span class="scheme">{new URL(link.url).protocol}//</span>{linkHost(link.url)}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<section class="link-group" aria-labelledby="links-this-site">
			<h2 id="links-this-site" data-reveal>{copy.links.thisSite}</h2>
			<div class="site-card surface" data-reveal>
				<img class="site-avatar" src="/apple-touch-icon.png" width="72" height="72" alt="" loading="lazy" />
				<div>
					<p class="site-intro meta">{copy.links.thisSiteIntroduction}</p>
					<CodeWindow filename="link.yml" label={copy.links.thisSite} lines={siteYaml} copyable />
				</div>
			</div>
		</section>

		<div class="link-notes" data-reveal>
			<section aria-labelledby="links-guidelines">
				<h2 id="links-guidelines">{copy.links.guidelines}</h2>
				<ol class="checklist">
					{copy.links.guidelineItems.map((item) => <li>{item}</li>)}
				</ol>
			</section>
			<section aria-labelledby="links-apply">
				<h2 id="links-apply">{copy.links.apply}</h2>
				<p>
					{applyBefore}<a href={`mailto:${siteLinkCard.email}`}>{siteLinkCard.email}</a>{applyAfter}
				</p>
				<ol class="checklist">
					{copy.links.applyItems.map((item) => <li>{item}</li>)}
				</ol>
			</section>
		</div>
	</div>
</SiteLayout>

<style>
	.link-group {
		padding-block: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--border);
	}

	h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.35rem, 2.3vw, 1.85rem);
	}

	.link-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.link-card {
		display: flex;
		height: 100%;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.15rem 1.25rem;
		color: var(--text);
		text-decoration: none;
		transition: border-color 160ms ease-out;
	}

	.link-card:hover {
		border-color: var(--accent);
	}

	.link-name {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.link-arrow {
		color: var(--text-muted);
		transition: transform 160ms var(--ease-out);
	}

	.link-card:hover .link-arrow {
		color: var(--accent-strong);
	}

	@media (hover: hover) and (pointer: fine) {
		.link-card:hover .link-arrow {
			transform: translate(2px, -2px);
		}
	}

	.link-description {
		color: var(--text-muted);
		font-family: var(--font-reading);
	}

	.link-host {
		margin-top: auto;
		font-size: 0.8rem;
		overflow-wrap: anywhere;
	}

	.scheme {
		color: var(--text-faint);
	}

	.site-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
		padding: 1.25rem;
	}

	.site-avatar {
		border-radius: var(--radius-small);
	}

	.site-intro {
		margin: 0 0 1rem;
	}

	.link-notes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 4rem);
		padding-block: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--border);
	}

	.link-notes p,
	.link-notes ol {
		margin: 0 0 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-reading);
	}

	.link-notes a {
		color: var(--accent-strong);
	}

	/* Pre-flight checklist: numbered items with dashed separators. */
	.checklist {
		padding: 0;
		counter-reset: checklist;
		list-style: none;
	}

	.checklist li {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.5rem;
		padding-block: 0.55rem;
		border-top: 1px dashed var(--border);
		counter-increment: checklist;
	}

	.checklist li:last-child {
		border-bottom: 1px dashed var(--border);
	}

	.checklist li::before {
		content: counter(checklist, decimal-leading-zero);
		padding-top: 0.2em;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.link-grid,
		.link-notes {
			grid-template-columns: 1fr;
		}

		.site-card {
			grid-template-columns: 1fr;
		}
	}
</style>
