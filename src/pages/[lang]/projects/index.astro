---
import { prefixedLocales, type Locale } from '../../../lib/i18n';
import ProjectsPage from '../../../views/ProjectsPage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<ProjectsPage locale={Astro.props.locale} />
