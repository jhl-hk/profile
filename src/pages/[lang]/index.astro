---
import { prefixedLocales, type Locale } from '../../lib/i18n';
import HomePage from '../../views/HomePage.astro';

export function getStaticPaths() {
	return prefixedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}
---

<HomePage locale={Astro.props.locale} />
