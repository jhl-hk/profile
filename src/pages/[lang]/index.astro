---
import type { ComponentProps } from 'astro/types';
import { getCollection } from 'astro:content';
import CodeWindow from '../../components/CodeWindow.astro';
import DepartureBoard from '../../components/DepartureBoard.astro';
import HeroRoute from '../../components/HeroRoute.astro';
import ServerRack from '../../components/ServerRack.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { profile } from '../../data/profile';
import { projects } from '../../data/projects';
import { getUiCopy } from '../../i18n/ui';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedPosts } from '../../lib/content';
import { locales, type Locale } from '../../lib/i18n';
import { staticLanguageTargets } from '../../lib/seo';
import { isCurrent } from '../../lib/timeline';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiCopy(locale);
const publishedInLocale = publishedPosts(await getCollection('blog'), locale);
const posts = publishedInLocale.slice(0, 5);
const languageTargets = staticLanguageTargets('/');
const { role, location, tagline, highlights } = profile.copy[locale];
const stats = [
	{ label: copy.home.stats.posts, value: publishedInLocale.length },
	{ label: copy.home.stats.projects, value: projects.length },
	{ label: copy.home.stats.languages, value: profile.skills.filter((skill) => skill.category === 'language').length },
	{ label: copy.home.stats.activeRoles, value: [...profile.work, ...profile.projects].filter((record) => isCurrent(record)).length },
];
const profileSnippet: ComponentProps<typeof CodeWindow>['lines'] = [
	[['keyword', 'export const'], [null, ' jhl = {']],
	[[null, '  role: '], ['string', `'${role}'`], [null, ',']],
	[[null, '  base: '], ['string', `'${location}'`], [null, ', '], ['comment', '// RJTT 35°33′N 139°47′E']],
	[[null, '  stack: ['], ['string', "'TypeScript'"], [null, ', '], ['string', "'Go'"], [null, ', '], ['string', "'Python'"], [null, '],']],
	[[null, '  interests: ['], ['string', "'networks'"], [null, ', '], ['string', "'servers'"], [null, ', '], ['string', "'aviation'"], [null, '],']],
	[[null, '} '], ['keyword', 'as const'], [null, ';']],
];
---

<SiteLayout
	locale={locale}
	title={profile.name}
	description={profile.copy[locale].bio}
	pathname={`/${locale}/`}
	languageTargets={languageTargets}
	mainClass="home-page"
>
	<div class="page-shell">
		<section class="home-hero" aria-labelledby="home-title">
			<HeroRoute />
			<div class="hero-copy" data-hero-copy>
				<p class="eyebrow" data-reveal>{copy.home.eyebrow}</p>
				<h1 id="home-title" data-reveal="words">{profile.name}</h1>
				<p class="home-tagline" data-reveal>{tagline}</p>
				<ul class="home-points">
					{highlights.map((point) => <li data-reveal>{point}</li>)}
				</ul>
				<div class="home-facts" data-reveal>
					<p><span>{copy.home.currentRole}</span>{role}</p>
					<p><span>{copy.home.basedIn}</span>{location}</p>
				</div>
				<dl class="home-stats" data-reveal>
					{stats.map(({ label, value }) => (
						<div>
							<dt>{label}</dt>
							<dd data-count={value}>{String(value).padStart(2, '0')}</dd>
						</div>
					))}
				</dl>
			</div>
			<div class="home-snippet">
				<CodeWindow filename="~/jhl/profile.ts" label={copy.home.profileSnippet} lines={profileSnippet} />
			</div>
		</section>

		<section class="home-section" aria-labelledby="featured-projects">
			<div class="section-heading" data-scroll-heading>
				<h2 id="featured-projects">{copy.home.featuredProjects}</h2>
				<a href={`/${locale}/projects/`}>{copy.actions.viewAll}</a>
			</div>
			<ServerRack projects={projects} locale={locale} />
		</section>

		<section class="home-section" aria-labelledby="recent-writing">
			<div class="section-heading" data-scroll-heading>
				<h2 id="recent-writing">{copy.home.recentWriting}</h2>
				<a href={`/${locale}/blog/`}>{copy.actions.viewAll}</a>
			</div>
			{
				posts.length > 0
					? <DepartureBoard posts={posts} locale={locale} />
					: <p class="empty-state" data-reveal>{copy.blog.empty}</p>
			}
		</section>

		<section class="home-contact surface" aria-labelledby="contact-title" data-reveal>
			<div>
				<p class="eyebrow">{copy.actions.getInTouch}</p>
				<h2 id="contact-title">{profile.copy[locale].contact}</h2>
			</div>
			<SocialLinks locale={locale} />
		</section>
	</div>
</SiteLayout>

<style>
	.home-hero {
		position: relative;
		isolation: isolate;
		padding-bottom: clamp(5rem, 12vw, 10rem);
	}

	.hero-copy {
		max-width: 58rem;
		padding-top: clamp(2rem, 7vw, 6rem);
	}

	.home-hero h1 {
		margin-bottom: 0.2em;
	}

	.home-tagline {
		max-width: 40rem;
		margin-bottom: 1.5rem;
		color: var(--text-muted);
		font-family: var(--font-reading);
		font-size: clamp(1.3rem, 3vw, 1.9rem);
		line-height: 1.35;
	}

	.home-points {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, max-content));
		gap: 0.55rem 2.25rem;
		margin: 0 0 2.25rem;
		padding: 0;
		list-style: none;
	}

	.home-points li {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.home-points li::before {
		content: '▸';
		content: '▸' / '';
		color: var(--accent);
		font-family: var(--font-mono);
	}

	.home-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem clamp(2rem, 6vw, 5rem);
	}

	.home-facts p {
		margin: 0;
		font-weight: 700;
	}

	.home-facts span {
		display: block;
		margin-bottom: 0.2rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, max-content));
		gap: 1rem clamp(1.5rem, 5vw, 3.5rem);
		margin: 2.25rem 0 0;
	}

	.home-stats div {
		display: flex;
		flex-direction: column-reverse;
	}

	.home-stats dt {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-stats dd {
		margin: 0;
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: clamp(2rem, 5vw, 3rem);
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		line-height: 1.1;
	}

	@media (max-width: 640px) {
		.home-points {
			grid-template-columns: 1fr;
		}

		.home-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.home-snippet {
		max-width: 40rem;
		margin-top: 2.75rem;
	}

	.home-section {
		margin-bottom: clamp(5rem, 12vw, 9rem);
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 3rem);
	}

	.section-heading a {
		font-size: 0.9rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.empty-state {
		padding-block: 1.75rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
	}

	.home-contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: end;
		padding: clamp(1.5rem, 5vw, 3.5rem);
	}

	.home-contact h2 {
		max-width: 46rem;
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.75rem);
	}

	@media (max-width: 720px) {
		.home-contact {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}
</style>
