---
import { type CollectionEntry, getCollection } from 'astro:content';
import { articlePaths } from '../../lib/content';
import { defaultLocale } from '../../lib/i18n';
import ArticlePage from '../../views/ArticlePage.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === defaultLocale);
	return articlePaths(posts).map(({ params, props }) => ({ params: { slug: params.slug }, props }));
}

interface Props {
	post: CollectionEntry<'blog'>;
}
---

<ArticlePage post={Astro.props.post} />
