---
import { getCollection } from 'astro:content';
import RedirectPage from '../../components/RedirectPage.astro';
import { postSlug, translationTargets } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts
		.filter((post) => post.data.lang === 'en')
		.map((post) => ({
			params: { slug: postSlug(post) },
			props: { targets: { ...translationTargets(posts, post), en: `/en/blog/${postSlug(post)}/` } },
		}));
}

interface Props {
	targets: Parameters<typeof RedirectPage>[0]['targets'];
}

const { targets } = Astro.props;
---

<RedirectPage targets={targets} />
