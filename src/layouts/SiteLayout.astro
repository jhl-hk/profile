---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import ChartBackground from '../components/ChartBackground.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getUiCopy } from '../i18n/ui';
import { defaultLocale, type Locale } from '../lib/i18n';
import type { LanguageTargets } from '../lib/seo';

interface Props {
	locale?: Locale;
	title: string;
	description: string;
	pathname?: string;
	languageTargets?: LanguageTargets;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	mainClass?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const pathname = Astro.props.pathname ?? Astro.url.pathname;
const languageTargets = Astro.props.languageTargets ?? { [locale]: pathname };
const {
	title,
	description,
	image,
	type = 'website',
	mainClass,
} = Astro.props;
const copy = getUiCopy(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			locale={locale}
			title={title}
			description={description}
			image={image}
			type={type}
			languageTargets={languageTargets}
		/>
	</head>
	<body data-copy-label={copy.actions.copy} data-copied-label={copy.actions.copied}>
		<a class="skip-link" href="#content">{copy.accessibility.skipToContent}</a>
		<ChartBackground />
		<div class="flight-progress" aria-hidden="true" data-flight-progress>
			<span class="flight-progress-origin"></span>
			<span class="flight-progress-flown"></span>
			<span class="flight-progress-destination"></span>
			<span class="flight-progress-lane">
				<svg class="flight-progress-plane" viewBox="-12 -10 24 20">
					<path d="M11 0 L5 -1.3 L-1 -9 L-3.6 -9 L0 -1.3 L-6 -1.3 L-8.5 -4 L-10 -4 L-8.5 0 L-10 4 L-8.5 4 L-6 1.3 L0 1.3 L-3.6 9 L-1 9 L5 1.3 Z" />
				</svg>
			</span>
		</div>
		<Header locale={locale} pathname={pathname} languageTargets={languageTargets} />
		<main id="content" class:list={['site-main', mainClass]}>
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>

<script>
	import { initCodeCopy } from '../lib/code-copy';
	import { initFlightProgress, initScrollHeadings, initTilt } from '../lib/live-motion';
	import { initReveals } from '../lib/motion';

	initReveals();
	initCodeCopy(document.body);
	initScrollHeadings();
	initTilt();
	const progress = document.querySelector<HTMLElement>('[data-flight-progress]');
	if (progress) initFlightProgress(progress);
</script>

<style>
	.site-main {
		min-height: 60vh;
		padding-block: clamp(2.5rem, 8vw, 7rem);
	}

	/*
	 * Scroll progress as a flight: dashed planned track, solid flown track, and
	 * the plane at its leading edge. live-motion.ts drives --progress (0–1).
	 */
	.flight-progress {
		--progress: 0;
		--track-y: 9px;
		position: fixed;
		z-index: 50;
		inset: 0 0 auto;
		display: none;
		height: 20px;
		background: linear-gradient(var(--surface) 35%, transparent);
		pointer-events: none;
	}

	.flight-progress[data-active] {
		display: block;
	}

	.flight-progress::before {
		content: '';
		position: absolute;
		top: var(--track-y);
		right: 10px;
		left: 10px;
		border-top: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.flight-progress-flown {
		position: absolute;
		top: calc(var(--track-y) - 0.5px);
		right: 10px;
		left: 10px;
		height: 2px;
		background: var(--accent);
		transform: scaleX(var(--progress));
		transform-origin: left;
	}

	.flight-progress-origin,
	.flight-progress-destination {
		position: absolute;
		top: calc(var(--track-y) - 3.5px);
		width: 8px;
		height: 8px;
		border: 1.5px solid var(--accent);
		background: var(--surface);
	}

	.flight-progress-origin {
		left: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.flight-progress-destination {
		right: 6px;
		transform: rotate(45deg);
	}

	/* The lane is narrower than the track by the plane's width, so the plane stops at the destination. */
	.flight-progress-lane {
		position: absolute;
		inset: 0 30px 0 2px;
		transform: translateX(calc(var(--progress) * 100%));
	}

	.flight-progress-plane {
		position: absolute;
		top: calc(var(--track-y) - 8px);
		left: 0;
		width: 20px;
		height: 17px;
		overflow: visible;
		fill: var(--accent-strong);
		stroke: var(--surface);
		stroke-width: 1.5;
		paint-order: stroke;
	}

	@media (prefers-reduced-motion: reduce) {
		.flight-progress {
			display: none !important;
		}
	}
</style>
