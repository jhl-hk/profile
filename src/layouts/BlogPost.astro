---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import FlightStrip from '../components/FlightStrip.astro';
import TraceBreadcrumb from '../components/TraceBreadcrumb.astro';
import { getUiCopy } from '../i18n/ui';
import { postSlug } from '../lib/content';
import { flightNumber } from '../lib/flight';
import { formatDate, localeLabels, type Locale } from '../lib/i18n';
import type { LanguageTargets } from '../lib/seo';
import SiteLayout from './SiteLayout.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	locale: Locale;
	headings: MarkdownHeading[];
	readingMinutes: number;
	languageTargets: LanguageTargets;
	previous?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
}

const { post, locale, headings, readingMinutes, languageTargets, previous, next } = Astro.props;
const copy = getUiCopy(locale).blog;
const pathname = `/${locale}/blog/${postSlug(post)}/`;
const translations = Object.entries(languageTargets) as [Locale, string][];
const showTableOfContents = headings.length >= 2;
---

<SiteLayout
	locale={locale}
	title={post.data.title}
	description={post.data.description}
	pathname={pathname}
	languageTargets={languageTargets}
	image={post.data.heroImage}
	type="article"
	mainClass="blog-post-page"
>
	<article class="page-shell">
		<header class="article-header reading-column">
			<TraceBreadcrumb locale={locale} hops={[{ label: 'blog', href: `/${locale}/blog/` }, { label: postSlug(post) }]} />
			<FlightStrip date={post.data.pubDate} readingMinutes={readingMinutes} locale={locale} />
			{post.data.sample && <p class="sample-line" data-reveal><span class="sample-badge">{copy.sample}</span></p>}
			<h1 data-reveal>{post.data.title}</h1>
			<p class="description" data-reveal>{post.data.description}</p>
			{
				post.data.updatedDate && (
					<p class="updated meta" data-reveal>
						{copy.updated} <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, locale)}</time>
					</p>
				)
			}
			{
				post.data.topics.length > 0 && (
					<ul class="article-topics" aria-label={copy.topics} data-reveal>
						{post.data.topics.map((topic) => <li>{topic}</li>)}
					</ul>
				)
			}
		</header>

		{
			post.data.heroImage && (
				<div class="hero-image surface" data-reveal>
					<Image src={post.data.heroImage} width={1080} alt="" loading="eager" />
				</div>
			)
		}

		<div class:list={['article-body', { 'has-toc': showTableOfContents }]}>
			{
				showTableOfContents && (
					<aside class="table-of-contents" aria-labelledby="toc-title" data-reveal>
						<h2 id="toc-title">{copy.tableOfContents}</h2>
						<ol data-toc>
							{headings.map((heading) => (
								<li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
							))}
						</ol>
					</aside>
				)
			}
			<div class="reading-column prose">
				<slot />
			</div>
		</div>

		<footer class="article-footer reading-column">
			{translations.length > 1 && (
			<section class="translations" aria-labelledby="translations-title" data-reveal>
				<h2 id="translations-title">{copy.translations}</h2>
				<ul>
					{
						translations.map(([targetLocale, href]) => (
							<li>
								<a href={href} hreflang={targetLocale} lang={targetLocale} aria-current={targetLocale === locale ? 'page' : undefined}>
									{localeLabels[targetLocale]}
								</a>
							</li>
						))
					}
				</ul>
			</section>
			)}

			{
				(previous || next) && (
					<nav class="post-navigation" aria-label={`${copy.previous} / ${copy.next}`} data-reveal>
						{previous ? (
							<a class="previous" href={`/${locale}/blog/${postSlug(previous)}/`}>
								<span>← {copy.previous} · {flightNumber(previous.data.pubDate)}</span>
								<strong>{previous.data.title}</strong>
							</a>
						) : <span />}
						{next && (
							<a class="next" href={`/${locale}/blog/${postSlug(next)}/`}>
								<span>{flightNumber(next.data.pubDate)} · {copy.next} →</span>
								<strong>{next.data.title}</strong>
							</a>
						)}
					</nav>
				)
			}
		</footer>
	</article>
</SiteLayout>

<script>
	import { trackFlightPlan } from '../lib/article';

	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) trackFlightPlan(toc);
</script>

<style>
	.article-header {
		--trace-align: center;
		padding-block: clamp(2rem, 6vw, 5rem);
		text-align: center;
	}

	.sample-line {
		margin: 0 0 1rem;
	}

	.article-header h1 {
		margin-bottom: 0.3em;
		font-size: clamp(2.1rem, 5vw, 3.75rem);
		line-height: 1.1;
	}

	.description {
		max-width: 42rem;
		margin-inline: auto;
		color: var(--text-muted);
		font-family: var(--font-reading);
		font-size: clamp(1.15rem, 2.5vw, 1.45rem);
	}

	.updated {
		margin-bottom: 1rem;
	}

	.sample-badge {
		padding: 0.08rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border));
		border-radius: var(--radius-pill);
		color: var(--accent-strong);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.article-topics {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-topics li {
		color: var(--text-faint);
		font-size: 0.82rem;
	}

	.article-topics li::before {
		content: '#';
	}

	article.page-shell {
		--page-width: 1320px;
	}

	.hero-image {
		width: min(100%, 1080px);
		margin-inline: auto;
		overflow: hidden;
		margin-bottom: clamp(3rem, 8vw, 6rem);
	}

	.hero-image :global(img) {
		width: 100%;
		max-height: 38rem;
		object-fit: cover;
	}

	.article-body {
		position: relative;
	}

	.article-body.has-toc {
		display: grid;
		grid-template-columns: 12rem minmax(0, var(--reading-width)) 12rem;
		gap: 3rem;
		justify-content: center;
		align-items: start;
	}

	.article-body.has-toc .prose {
		grid-column: 2;
	}

	.table-of-contents {
		position: sticky;
		top: 1.5rem;
		grid-column: 1;
		max-height: calc(100vh - 3rem);
		overflow-y: auto;
		padding-inline-end: 1rem;
	}

	.table-of-contents h2 {
		margin-bottom: 0.9rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	/* Flight plan: headings are waypoints on a route line. */
	.table-of-contents ol {
		--waypoint-x: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.table-of-contents li {
		position: relative;
		padding: 0.25rem 0 0.25rem 1.2rem;
		font-family: var(--font-ui);
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.table-of-contents li::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 var(--waypoint-x);
		width: 1px;
		background: var(--border);
		transition: background-color 160ms ease;
	}

	.table-of-contents li:first-child::before {
		top: 0.95em;
	}

	.table-of-contents li:last-child::before {
		bottom: calc(100% - 0.95em);
	}

	.table-of-contents li[data-passed]::before {
		background: var(--accent);
	}

	.table-of-contents .depth-3,
	.table-of-contents .depth-4,
	.table-of-contents .depth-5,
	.table-of-contents .depth-6 {
		padding-inline-start: 2rem;
	}

	.table-of-contents a {
		display: block;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.table-of-contents a::before {
		content: '';
		position: absolute;
		top: calc(0.25rem + 0.7em - 4px);
		left: calc(var(--waypoint-x) - 3.5px);
		width: 8px;
		height: 8px;
		border: 1.5px solid var(--text-faint);
		background: var(--surface);
		transform: rotate(45deg);
		transition: background-color 160ms ease, border-color 160ms ease;
	}

	.table-of-contents li[data-passed] a::before {
		border-color: var(--accent);
		background: var(--accent);
	}

	.table-of-contents a[aria-current='location'] {
		color: var(--text);
		font-weight: 700;
	}

	.table-of-contents a[aria-current='location']::before {
		border-color: var(--accent);
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
	}

	@media (hover: hover) and (pointer: fine) {
		.table-of-contents a:hover {
			color: var(--text);
		}
	}

	.article-footer {
		padding-top: clamp(3rem, 8vw, 6rem);
	}

	.translations {
		padding-block: 1.5rem;
		border-block: 1px solid var(--border);
	}

	.translations h2 {
		margin-bottom: 0.7rem;
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.translations ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.translations a[aria-current='page'] {
		color: var(--text-muted);
		text-decoration: none;
	}

	.post-navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		padding-top: 2rem;
	}

	.post-navigation a {
		display: flex;
		min-height: 6rem;
		flex-direction: column;
		justify-content: center;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-small);
		color: var(--text);
		text-decoration: none;
	}

	.post-navigation a:hover {
		border-color: var(--accent);
	}

	.post-navigation span {
		margin-bottom: 0.35rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.post-navigation .next {
		text-align: end;
	}

	@media (max-width: 1180px) {
		.article-body.has-toc {
			grid-template-columns: minmax(0, var(--reading-width));
			justify-content: center;
		}

		.article-body.has-toc .prose,
		.table-of-contents {
			grid-column: 1;
		}

		.table-of-contents {
			position: static;
			width: min(100%, var(--reading-width));
			margin-inline: auto;
			padding: 1rem;
			border: 1px solid var(--border);
			border-radius: var(--radius-small);
		}
	}

	@media (max-width: 600px) {
		.post-navigation {
			grid-template-columns: 1fr;
		}

		.post-navigation .next {
			text-align: start;
		}
	}
</style>
